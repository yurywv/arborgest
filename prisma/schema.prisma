// ArborGest — modelo relacional
// Convenções:
//  * Tree guarda somente dados relativamente permanentes (identificação, localização,
//    botânica, local de implantação e conflitos com infraestrutura).
//  * Dados históricos ficam em tabelas próprias: TreeMeasurement (biometria),
//    Inspection + InspectionFinding (condição de raízes/tronco/copa/fitossanidade),
//    RiskAssessment, Intervention, WorkOrder, Photo, Document.
//  * Campos "current*" / "last*" / "next*" em Tree são cache desnormalizado do estado
//    mais recente (atualizados pela aplicação) para permitir filtros rápidos no mapa
//    e no dashboard. Nunca são a fonte da verdade.
//  * Códigos permanentes (ARB-000001, OS-2026-0001, CT-2026-0001) são gerados pela
//    tabela Counter com incremento atômico e nunca são reutilizados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum TreeStatus {
  ATIVA
  MORTA
  REMOVIDA
  TRANSPLANTADA
  SUBSTITUIDA
  NAO_LOCALIZADA
}

enum Condition {
  OTIMA
  BOA
  REGULAR
  RUIM
  CRITICA
}

enum RiskLevel {
  BAIXO
  MODERADO
  ALTO
  EXTREMO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum ClientStatus {
  PROSPECT
  ATIVO
  INATIVO
}

enum OpportunityStage {
  LEAD
  QUALIFICACAO
  VISITA
  PROPOSTA
  NEGOCIACAO
  GANHA
  PERDIDA
}

enum ContractStatus {
  RASCUNHO
  ATIVO
  SUSPENSO
  ENCERRADO
  CANCELADO
}

enum InterventionStatus {
  RECOMENDADA
  PROGRAMADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum WorkOrderStatus {
  ABERTA
  PROGRAMADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum FindingCategory {
  RAIZES
  TRONCO
  COPA
  FITOSSANIDADE
}

// ─────────────────────── Usuários e acesso ───────────────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // ADMIN, GESTOR, TECNICO, COMERCIAL, OPERACIONAL, CONSULTA
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  jobTitle       String?
  passwordHash   String
  active         Boolean   @default(true)
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  lastLoginAt    DateTime?
  // Incrementado ao trocar senha / desativar: invalida sessões antigas.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teams                Team[]                    @relation("TeamMembers")
  resetTokens          PasswordResetToken[]
  opportunities        Opportunity[]
  contracts            Contract[]
  responsibleTrees     Tree[]                    @relation("TreeResponsible")
  measurements         TreeMeasurement[]
  inspections          Inspection[]
  riskAssessments      RiskAssessment[]
  interventions        Intervention[]
  workOrders           WorkOrder[]
  photos               Photo[]
  documents            Document[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  pricingParamVersions PricingParameterVersion[] @relation("PricingParamAuthor")
  estimatesCreated     PricingEstimate[]         @relation("EstimateCreator")
  estimatesCommercial  PricingEstimate[]         @relation("EstimateCommercial")
  estimatesTechnical   PricingEstimate[]         @relation("EstimateTechnical")
  pricingCalculations  PricingCalculation[]
  pricingOverrides     PricingOverride[]
  proposalsCreated     CommercialProposal[]
  approvalsRequested   ProposalApproval[]        @relation("ApprovalRequester")
  approvalsDecided     ProposalApproval[]        @relation("ApprovalDecider")
  pricingAuditLogs     PricingAuditLog[]
}

model Team {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  active        Boolean        @default(true)
  members       User[]         @relation("TeamMembers")
  interventions Intervention[]
  workOrders    WorkOrder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─────────────────────────── CRM ───────────────────────────

model Client {
  id         String       @id @default(cuid())
  legalName  String // razão social / nome completo
  tradeName  String? // nome fantasia
  document   String?      @unique // CPF/CNPJ (somente dígitos)
  clientType String // PF, PJ, ORGAO_PUBLICO, CONDOMINIO
  segment    String?
  phone      String?
  email      String?
  website    String?
  address    String?
  district   String?
  city       String?
  state      String?      @db.VarChar(2)
  zipCode    String?
  notes      String?
  status     ClientStatus @default(ATIVO)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  contacts         Contact[]
  opportunities    Opportunity[]
  contracts        Contract[]
  properties       Property[]
  workOrders       WorkOrder[]
  documents        Document[]
  pricingEstimates PricingEstimate[]
  proposals        CommercialProposal[]

  @@index([legalName])
  @@index([status])
}

model Contact {
  id               String               @id @default(cuid())
  clientId         String
  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  type             ContactType          @default(GERAL)
  jobTitle         String?
  phone            String?
  mobile           String?
  whatsapp         String?
  email            String?
  isPrimary        Boolean              @default(false)
  notes            String?
  pricingEstimates PricingEstimate[]
  proposals        CommercialProposal[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([clientId])
  @@index([type])
}

enum ContactType {
  GERAL
  ADMINISTRATIVO
  COMERCIAL
  TECNICO
}

model Opportunity {
  id               String            @id @default(cuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description      String
  service          String?
  estimatedValue   Decimal?          @db.Decimal(12, 2)
  stage            OpportunityStage  @default(LEAD)
  probability      Int               @default(10)
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  expectedDate     DateTime?
  source           String?
  notes            String?
  pricingEstimates PricingEstimate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([stage])
  @@index([clientId])
}

model Contract {
  id                String           @id @default(cuid())
  number            String           @unique
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  propertyId        String?
  property          Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  startDate         DateTime
  endDate           DateTime?
  value             Decimal?         @db.Decimal(12, 2)
  periodicity       String? // MENSAL, TRIMESTRAL, SEMESTRAL, ANUAL, AVULSO
  object            String
  ownerId           String?
  owner             User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status            ContractStatus   @default(ATIVO)
  notes             String?
  documents         Document[]
  pricingEstimateId String?
  pricingEstimate   PricingEstimate? @relation(fields: [pricingEstimateId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clientId])
  @@index([endDate])
}

// ─────────────────────── Propriedades e setores ───────────────────────

model Property {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name         String
  propertyType String? // CONDOMINIO, INDUSTRIA, PARQUE, ...
  address      String?
  number       String?
  complement   String?
  district     String?
  city         String?
  state        String?  @db.VarChar(2)
  zipCode      String?
  latitude     Float?
  longitude    Float?
  notes        String?
  totalArea    Float? // m²
  localManager String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sectors          Sector[]
  trees            Tree[]
  contracts        Contract[]
  workOrders       WorkOrder[]
  documents        Document[]
  pricingEstimates PricingEstimate[]
  proposals        CommercialProposal[]

  @@index([clientId])
}

model Sector {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  latitude    Float?
  longitude   Float?
  approxArea  Float? // m²
  trees       Tree[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, name])
}

// ─────────────────────────── Botânica ───────────────────────────

model Species {
  id             String   @id @default(cuid())
  scientificName String   @unique
  popularName    String
  family         String?
  genus          String?
  epithet        String? // epíteto específico
  origin         String? // NATIVA, EXOTICA
  nativeRange    String? // ex.: Mata Atlântica, Cerrado, Ásia
  invasive       Boolean  @default(false)
  notes          String?
  trees          Tree[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([popularName])
}

// ─────────────────────────── Exemplares ───────────────────────────

model Tree {
  id     String     @id @default(cuid())
  code   String     @unique // ARB-000001 (permanente, nunca reutilizado)
  status TreeStatus @default(ATIVA)

  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sectorId      String?
  sector        Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  responsibleId String?
  responsible   User?    @relation("TreeResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  // Localização (WGS84 / EPSG:4326)
  latitude      Float?
  longitude     Float?
  gpsAccuracy   Float? // metros
  altitude      Float? // metros
  gpsCapturedAt DateTime?
  coordSource   String? // GPS_DISPOSITIVO, MAPA, GNSS_RTK, IMPORTACAO, MANUAL
  geodeticDatum String    @default("WGS84 / EPSG:4326")
  address       String?
  physicalRef   String? // referência física (ex.: "em frente ao portão 2")

  // Identificação botânica
  speciesId                String?
  species                  Species? @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  cultivar                 String?
  identificationConfidence String? // ALTA, MEDIA, BAIXA
  botanicalNotes           String?

  // Local de implantação
  siteType       String? // CALCADA, PRACA, PARQUE, ...
  pavementType   String?
  permeableArea  Float? // m²
  sidewalkWidth  Float? // m
  bedWidth       Float? // m
  bedLength      Float? // m
  soilVolume     Float? // m³
  soilCompaction String? // BAIXA, MEDIA, ALTA
  drainage       String? // BOA, REGULAR, RUIM
  sunExposure    String? // PLENO_SOL, MEIA_SOMBRA, SOMBRA

  // Infraestrutura e conflitos (códigos de lib/catalogs.ts)
  conflicts     String[]
  conflictNotes String?

  notes String?

  // Cache do estado atual (derivado das tabelas históricas)
  currentDap       Float?
  currentHeight    Float?
  currentCrownDiam Float?
  currentCondition Condition?
  currentRisk      RiskLevel?
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  coverPhotoId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurements    TreeMeasurement[]
  inspections     Inspection[]
  riskAssessments RiskAssessment[]
  interventions   Intervention[]
  workOrders      WorkOrder[]           @relation("WorkOrderTrees")
  photos          Photo[]
  documents       Document[]
  pricingItems    PricingEstimateItem[] @relation("PricingItemTrees")

  @@index([propertyId])
  @@index([sectorId])
  @@index([speciesId])
  @@index([status])
  @@index([nextInspectionAt])
}

model TreeMeasurement {
  id                String   @id @default(cuid())
  treeId            String
  tree              Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  measuredAt        DateTime @default(now())
  measuredById      String?
  measuredBy        User?    @relation(fields: [measuredById], references: [id], onDelete: SetNull)
  cap               Float? // cm — circunferência à altura do peito
  dap               Float? // cm — diâmetro à altura do peito (DAP = CAP / π)
  measurementHeight Float?   @default(1.3) // m
  stemCount         Int?     @default(1)
  stemDaps          Float[] // cm — DAP de cada fuste
  totalHeight       Float? // m
  stemHeight        Float? // m — altura do fuste
  crownBaseHeight   Float? // m — início da copa
  crownDiameterNS   Float? // m
  crownDiameterEW   Float? // m
  crownArea         Float? // m² — elipse π·(NS/2)·(LO/2)
  notes             String?
  createdAt         DateTime @default(now())

  @@index([treeId, measuredAt])
}

// ─────────────────────────── Inspeções ───────────────────────────

model Inspection {
  id                  String              @id @default(cuid())
  treeId              String
  tree                Tree                @relation(fields: [treeId], references: [id], onDelete: Cascade)
  inspectedAt         DateTime
  inspectorId         String?
  inspector           User?               @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  reason              String? // ROTINA, SOLICITACAO_CLIENTE, POS_TEMPESTADE, ...
  generalCondition    Condition
  rootCondition       Condition?
  trunkCondition      Condition?
  crownCondition      Condition?
  phytoCondition      Condition?
  // Medidas qualitativas associadas aos achados
  trunkLeanDegrees    Float?
  deadBranchesPercent Float?
  phytoSeverity       String? // BAIXA, MEDIA, ALTA
  probableDiagnosis   String?
  confirmedDiagnosis  String?
  problems            String?
  recommendation      String?
  priority            Priority            @default(MEDIA)
  nextInspectionAt    DateTime?
  notes               String?
  findings            InspectionFinding[]
  photos              Photo[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([treeId, inspectedAt])
}

// Achado/defeito observado numa inspeção (normalizado por categoria + código do catálogo)
model InspectionFinding {
  id           String          @id @default(cuid())
  inspectionId String
  inspection   Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category     FindingCategory
  code         String // ex.: CAVIDADES, GALHOS_SECOS, CUPINS
  notes        String?

  @@unique([inspectionId, category, code])
  @@index([category, code])
}

// ─────────────────────── Avaliação de risco (ISA TRAQ) ───────────────────────

model RiskAssessment {
  id                String     @id @default(cuid())
  treeId            String
  tree              Tree       @relation(fields: [treeId], references: [id], onDelete: Cascade)
  assessedAt        DateTime
  assessorId        String?
  assessor          User?      @relation(fields: [assessorId], references: [id], onDelete: SetNull)
  targets           String[] // PESSOAS, VEICULOS, ...
  targetOccupancy   String // RARA, OCASIONAL, FREQUENTE, CONSTANTE
  partAtRisk        String // parte com possibilidade de falha
  failureLikelihood String // IMPROVAVEL, POSSIVEL, PROVAVEL, IMINENTE
  impactLikelihood  String // MUITO_BAIXA, BAIXA, MEDIA, ALTA
  consequence       String // DESPREZIVEL, MENOR, SIGNIFICATIVA, SEVERA
  riskRating        RiskLevel
  recommendedAction String?
  residualRisk      RiskLevel?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([treeId, assessedAt])
  @@index([riskRating])
}

// ─────────────────────────── Operação ───────────────────────────

model Intervention {
  id            String             @id @default(cuid())
  treeId        String
  tree          Tree               @relation(fields: [treeId], references: [id], onDelete: Cascade)
  workOrderId   String?
  workOrder     WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  type          String // PODA_LIMPEZA, REMOCAO, ... (lib/catalogs.ts)
  description   String?
  recommendedAt DateTime?
  priority      Priority           @default(MEDIA)
  scheduledAt   DateTime?
  executedAt    DateTime?
  responsibleId String?
  responsible   User?              @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status        InterventionStatus @default(RECOMENDADA)
  estimatedCost Decimal?           @db.Decimal(12, 2)
  actualCost    Decimal?           @db.Decimal(12, 2)
  notes         String?
  photos        Photo[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([treeId])
  @@index([status, priority])
  @@index([scheduledAt])
}

model WorkOrder {
  id                String           @id @default(cuid())
  number            String           @unique // OS-2026-0001
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  propertyId        String?
  property          Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  trees             Tree[]           @relation("WorkOrderTrees")
  service           String
  description       String?
  priority          Priority         @default(MEDIA)
  scheduledAt       DateTime?
  executedAt        DateTime?
  teamId            String?
  team              Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  responsibleId     String?
  responsible       User?            @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  status            WorkOrderStatus  @default(ABERTA)
  cost              Decimal?         @db.Decimal(12, 2)
  notes             String?
  interventions     Intervention[]
  photos            Photo[]
  documents         Document[]
  pricingEstimateId String?
  pricingEstimate   PricingEstimate? @relation(fields: [pricingEstimateId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

// ─────────────────────── Arquivos ───────────────────────

model Photo {
  id             String        @id @default(cuid())
  storageKey     String        @unique
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  type           String // GERAL, COPA, TRONCO, RAIZES, DEFEITO, ANTES, DEPOIS, OUTRA
  description    String?
  takenAt        DateTime      @default(now())
  treeId         String?
  tree           Tree?         @relation(fields: [treeId], references: [id], onDelete: Cascade)
  inspectionId   String?
  inspection     Inspection?   @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  interventionId String?
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  workOrderId    String?
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  uploadedById   String?
  uploadedBy     User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([treeId])
}

model Document {
  id           String     @id @default(cuid())
  storageKey   String     @unique
  fileName     String
  mimeType     String
  size         Int
  type         String // LAUDO, AUTORIZACAO, RELATORIO, CONTRATO, DOCUMENTO_AMBIENTAL, OUTRO
  description  String?
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  treeId       String?
  tree         Tree?      @relation(fields: [treeId], references: [id], onDelete: Cascade)
  contractId   String?
  contract     Contract?  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
}

// ─────────────────────── Sistema ───────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // INSPECAO_VENCIDA, INSPECAO_PROXIMA, INTERVENCAO_PENDENTE, OS_ATRASADA, CONTRATO_VENCENDO
  title     String
  message   String
  link      String?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGIN_FAILED, UPLOAD, ...
  entity    String
  entityId  String?
  summary   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────── Precificação e propostas ───────────────────────────

enum PricingEngineVersion {
  V1_LEGACY_EXCEL
  V2_ARBORENT
}

enum PricingEstimateStatus {
  RASCUNHO
  EM_ELABORACAO
  EM_APROVACAO_INTERNA
  APROVADO_INTERNAMENTE
  ENVIADO_CLIENTE
  EM_NEGOCIACAO
  ACEITO
  RECUSADO
  CANCELADO
  EXPIRADO
}

enum ApprovalLevel {
  COMERCIAL
  GERENCIAL
  DIRETORIA
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

enum PricingOverrideType {
  MARGEM
  CUSTO_ADICIONAL
  PRECO_FINAL
  DESCONTO_PERCENTUAL
  DESCONTO_VALOR
  REMOCAO
}

enum ProposalStatus {
  RASCUNHO
  EMITIDA
  ENVIADA
  ACEITA
  RECUSADA
  CANCELADA
  SUBSTITUIDA
}

/// Versão imutável dos parâmetros de precificação. Toda alteração administrativa gera uma nova versão.
model PricingParameterVersion {
  id              String               @id @default(cuid())
  major           Int // 1 = motor v1 (legado Excel), 2 = motor v2 (padronizado)
  minor           Int
  label           String               @unique // "1.0", "1.1"…
  engineVersion   PricingEngineVersion
  effectiveFrom   DateTime             @default(now())
  description     String
  active          Boolean              @default(false)
  /// PricingParams completo — fonte de verdade para o motor; nunca é alterado após criado.
  snapshot        Json
  v2ValidatedAt   DateTime?
  v2ValidatedNote String?
  createdById     String?
  createdBy       User?                @relation("PricingParamAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  parameters   PricingParameter[]
  productivity PricingProductivityRule[]
  modifiers    PricingModifier[]
  serviceTypes PricingServiceType[]
  licenseTiers PricingLicenseTier[]
  estimates    PricingEstimate[]
  calculations PricingCalculation[]

  @@index([active])
}

/// Parâmetros escalares (custos, impostos, margem, regras) de uma versão.
model PricingParameter {
  id        String                  @id @default(cuid())
  versionId String
  version   PricingParameterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  group     String // GERAL, REGRAS, APROVACAO, SUPRESSAO…
  key       String
  label     String
  value     Decimal?                @db.Decimal(18, 6)
  textValue String?
  unit      String?

  @@unique([versionId, key])
}

/// Catálogo de serviços precificáveis (o cálculo de cada um fica no Pricing Engine).
model PricingService {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  unit        String   @default("árvore")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingProductivityRule {
  id          String                  @id @default(cuid())
  versionId   String
  version     PricingParameterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  serviceCode String
  difficulty  Int // 1 fácil, 2 média, 3 difícil
  label       String
  treesPerDay Decimal                 @db.Decimal(12, 4)

  @@unique([versionId, serviceCode, difficulty])
}

model PricingModifier {
  id              String                  @id @default(cuid())
  versionId       String
  version         PricingParameterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  serviceCode     String
  key             String
  description     String
  factor          Decimal                 @db.Decimal(10, 6)
  active          Boolean                 @default(true)
  order           Int                     @default(0)
  /// Comportamento adicional: dias acrescentados à operação quando ligado (rede elétrica = 1).
  addsDays        Int                     @default(0)
  /// Se participa do produto de fatores no motor v1 (a planilha não multiplica "rede elétrica").
  legacyInProduct Boolean                 @default(true)

  @@unique([versionId, serviceCode, key])
}

model PricingServiceType {
  id                String                  @id @default(cuid())
  versionId         String
  version           PricingParameterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  serviceCode       String
  code              Int
  label             String
  factor            Decimal                 @db.Decimal(10, 6)
  includesLicense   Boolean?
  cacambaArvoresPor Decimal?                @db.Decimal(10, 2)

  @@unique([versionId, serviceCode, code])
}

model PricingLicenseTier {
  id          String                  @id @default(cuid())
  versionId   String
  version     PricingParameterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  serviceCode String
  minTrees    Int
  maxTrees    Int?
  divisor     Decimal                 @db.Decimal(10, 4)
  hours       Decimal                 @db.Decimal(10, 4)
}

/// Orçamento (precificação). Pode ter vários itens de serviços diferentes.
model PricingEstimate {
  id                 String                  @id @default(cuid())
  number             String                  @unique // 2026-00125
  revision           Int                     @default(1)
  parentId           String?
  parent             PricingEstimate?        @relation("EstimateRevisions", fields: [parentId], references: [id], onDelete: SetNull)
  revisions          PricingEstimate[]       @relation("EstimateRevisions")
  title              String?
  clientId           String
  client             Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId          String?
  contact            Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  propertyId         String?
  property           Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  opportunityId      String?
  opportunity        Opportunity?            @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  date               DateTime                @default(now())
  validUntil         DateTime?
  commercialOwnerId  String?
  commercialOwner    User?                   @relation("EstimateCommercial", fields: [commercialOwnerId], references: [id], onDelete: SetNull)
  technicalOwnerId   String?
  technicalOwner     User?                   @relation("EstimateTechnical", fields: [technicalOwnerId], references: [id], onDelete: SetNull)
  status             PricingEstimateStatus   @default(RASCUNHO)
  parameterVersionId String
  parameterVersion   PricingParameterVersion @relation(fields: [parameterVersionId], references: [id], onDelete: Restrict)
  internalNotes      String?
  commercialNotes    String?

  // Totais (recalculados no servidor a cada alteração)
  calculatedTotal      Decimal        @default(0) @db.Decimal(14, 2) // soma dos preços calculados originais
  itemsTotal           Decimal        @default(0) @db.Decimal(14, 2) // soma dos preços dos itens após ajustes
  /// Margem de lucro definida para o orçamento (fração ≥ 0), aplicada aos itens sem margem/preço próprios.
  marginOverride       Decimal?       @db.Decimal(10, 6)
  marginReason         String?
  discountType         String? // PERCENT | AMOUNT
  discountValue        Decimal?       @db.Decimal(14, 4)
  discountReason       String?
  discountAmount       Decimal        @default(0) @db.Decimal(14, 2)
  negotiatedTotal      Decimal        @default(0) @db.Decimal(14, 2)
  operationalCostTotal Decimal        @default(0) @db.Decimal(14, 2)
  taxRate              Decimal        @default(0) @db.Decimal(8, 6)
  calculatedMargin     Decimal?       @db.Decimal(10, 6)
  effectiveMargin      Decimal?       @db.Decimal(10, 6)
  requiredApproval     ApprovalLevel?
  approvedLevel        ApprovalLevel?
  approvedAt           DateTime?
  sentAt               DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  closeReason          String?

  createdById String?
  createdBy   User?    @relation("EstimateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        PricingEstimateItem[]
  calculations PricingCalculation[]
  overrides    PricingOverride[]
  approvals    ProposalApproval[]
  proposals    CommercialProposal[]
  auditLogs    PricingAuditLog[]
  contracts    Contract[]
  workOrders   WorkOrder[]

  @@index([status])
  @@index([clientId])
  @@index([date])
}

model PricingEstimateItem {
  id                   String              @id @default(cuid())
  estimateId           String
  estimate             PricingEstimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  order                Int                 @default(0)
  serviceCode          String
  description          String?
  quantity             Int
  inputs               Json
  trees                Tree[]              @relation("PricingItemTrees")
  currentCalculationId String?             @unique
  currentCalculation   PricingCalculation? @relation("ItemCurrentCalc", fields: [currentCalculationId], references: [id], onDelete: SetNull)
  operationalCost      Decimal             @db.Decimal(14, 2)
  calculatedPrice      Decimal             @db.Decimal(14, 2) // preço calculado pelo motor (original)
  unitPrice            Decimal             @db.Decimal(14, 2)
  marginOverride       Decimal?            @db.Decimal(10, 6)
  extraCost            Decimal             @default(0) @db.Decimal(14, 2)
  extraCostReason      String?
  priceOverride        Decimal?            @db.Decimal(14, 2)
  negotiatedPrice      Decimal             @db.Decimal(14, 2) // preço do item após ajustes autorizados
  effectiveMargin      Decimal             @db.Decimal(10, 6)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  calculations PricingCalculation[] @relation("ItemCalcs")
  overrides    PricingOverride[]

  @@index([estimateId])
}

/// Cálculo salvo. `snapshot` é imutável e permite reconstruir o orçamento mesmo com regras novas.
model PricingCalculation {
  id                 String                        @id @default(cuid())
  estimateId         String?
  estimate           PricingEstimate?              @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemId             String?
  item               PricingEstimateItem?          @relation("ItemCalcs", fields: [itemId], references: [id], onDelete: SetNull)
  currentFor         PricingEstimateItem?          @relation("ItemCurrentCalc")
  parameterVersionId String
  parameterVersion   PricingParameterVersion       @relation(fields: [parameterVersionId], references: [id], onDelete: Restrict)
  engineVersion      PricingEngineVersion
  serviceCode        String
  snapshot           Json
  snapshotHash       String
  operationalCost    Decimal                       @db.Decimal(14, 2)
  finalPrice         Decimal                       @db.Decimal(14, 2)
  unitPrice          Decimal                       @db.Decimal(14, 2)
  createdById        String?
  createdBy          User?                         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime                      @default(now())
  components         PricingCalculationComponent[]

  @@index([itemId])
}

model PricingCalculationComponent {
  id            String             @id @default(cuid())
  calculationId String
  calculation   PricingCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  order         Int
  key           String
  label         String
  group         String
  value         Decimal            @db.Decimal(20, 6)
  formula       String
}

/// Ajuste manual autorizado (margem, desconto, custo adicional, preço final). Nunca apaga o preço calculado.
model PricingOverride {
  id              String               @id @default(cuid())
  estimateId      String
  estimate        PricingEstimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemId          String?
  item            PricingEstimateItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  type            PricingOverrideType
  previousValue   Decimal?             @db.Decimal(20, 6)
  newValue        Decimal?             @db.Decimal(20, 6)
  calculatedPrice Decimal?             @db.Decimal(14, 2)
  negotiatedPrice Decimal?             @db.Decimal(14, 2)
  difference      Decimal?             @db.Decimal(14, 2)
  discountPercent Decimal?             @db.Decimal(10, 6)
  reason          String
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@index([estimateId])
}

model CommercialProposal {
  id               String                   @id @default(cuid())
  number           String                   @unique // PROP-2026-00124
  version          Int                      @default(1)
  estimateId       String
  estimate         PricingEstimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  status           ProposalStatus           @default(RASCUNHO)
  date             DateTime                 @default(now())
  validUntil       DateTime?
  clientId         String
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId        String?
  contact          Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  propertyId       String?
  property         Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title            String
  object           String
  scope            String?
  deadline         String?
  paymentTerms     String?
  conditions       String?
  assumptions      String?
  exclusions       String?
  responsibilities String?
  notes            String?
  subtotal         Decimal                  @db.Decimal(14, 2)
  discountAmount   Decimal                  @default(0) @db.Decimal(14, 2)
  total            Decimal                  @db.Decimal(14, 2)
  sentAt           DateTime?
  sentTo           String?
  acceptedAt       DateTime?
  acceptedBy       String?
  createdById      String?
  createdBy        User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  items            CommercialProposalItem[]

  @@index([estimateId])
}

model CommercialProposalItem {
  id             String             @id @default(cuid())
  proposalId     String
  proposal       CommercialProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  order          Int
  serviceCode    String
  title          String
  description    String?
  quantity       Decimal            @db.Decimal(12, 2)
  unit           String
  unitPrice      Decimal            @db.Decimal(14, 2)
  total          Decimal            @db.Decimal(14, 2)
  estimateItemId String?
}

model ProposalApproval {
  id              String          @id @default(cuid())
  estimateId      String
  estimate        PricingEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  level           ApprovalLevel
  status          ApprovalStatus  @default(PENDENTE)
  marginAtRequest Decimal         @db.Decimal(10, 6)
  totalAtRequest  Decimal         @db.Decimal(14, 2)
  requestedById   String?
  requestedBy     User?           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt     DateTime        @default(now())
  decidedById     String?
  decidedBy       User?           @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  comment         String?

  @@index([estimateId])
  @@index([status])
}

/// Trilha de auditoria da precificação (valor anterior → novo, com justificativa).
model PricingAuditLog {
  id            String           @id @default(cuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  action        String
  entity        String
  entityId      String?
  estimateId    String?
  estimate      PricingEstimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  field         String?
  previousValue String?
  newValue      String?
  justification String?
  ip            String?

  @@index([estimateId])
  @@index([createdAt])
}

/// Regras municipais de compensação ambiental (referência para a quantidade de mudas por árvore suprimida).
/// A quantidade e a citação aplicadas ficam gravadas no item/snapshot do orçamento.
model CompensationRule {
  id               String   @id @default(cuid())
  city             String
  state            String   @db.Char(2)
  lawReference     String
  seedlingsPerTree Decimal  @db.Decimal(10, 2)
  freightValue     Decimal? @db.Decimal(12, 2)
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([city, state, lawReference])
  @@index([state, city])
}
