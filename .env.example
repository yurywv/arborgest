# ─────────── Banco de dados (PostgreSQL) ───────────
# Local:    postgresql://usuario:senha@localhost:5432/arbor?schema=public
# Neon/Supabase (Vercel): use a URL com pooling em DATABASE_URL e a conexão direta em DIRECT_URL.
# Railway: use ${{Postgres.DATABASE_URL}} nas duas variáveis.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arbor?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/arbor?schema=public"

# ─────────── Autenticação ───────────
# Segredo de assinatura das sessões (mín. 32 caracteres). Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais"
# URL pública (usada no QR Code e nos links de redefinição de senha)
APP_URL="http://localhost:3000"

# ─────────── Armazenamento de fotos e documentos ───────────
# "local" (disco; desenvolvimento ou Railway com volume) ou "s3" (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
# Somente para STORAGE_DRIVER=s3:
S3_BUCKET=""
S3_REGION="auto"
# R2: https://<account-id>.r2.cloudflarestorage.com · Supabase: https://<projeto>.supabase.co/storage/v1/s3
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "true" para Supabase Storage e MinIO
S3_FORCE_PATH_STYLE="false"

# ─────────── E-mail (recuperação de senha) ───────────
# Sem SMTP_HOST, o link é apenas registrado no log do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="ArborGest <no-reply@suaempresa.com.br>"

# ─────────── Alertas ───────────
# Protege /api/cron/notificacoes (Vercel Cron envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET="troque-por-um-segredo"

# ─────────── Primeiro administrador (npm run db:bootstrap) ───────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
